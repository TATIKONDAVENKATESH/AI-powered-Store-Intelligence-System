FROM python:3.11-slim

# System dependencies for OpenCV (if needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install CPU-only torch first to save 2GB
RUN pip install --no-cache-dir torch==2.3.0+cpu torchvision==0.18.0+cpu --index-url https://download.pytorch.org/whl/cpu

# Install remaining dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY . .

# Ensure storage directory exists for SQLite
RUN mkdir -p storage

# Make startup script executable
RUN chmod +x start.sh

# Expose the port Hugging Face Spaces expects
EXPOSE 7860

# Run the unified startup script
CMD ["./start.sh"]
